# Configurazione Server
PORT=5000

# Connessione MongoDB Atlas
# Sostituisci <db_user> e <db_password> con le credenziali create su Atlas
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/riciclapp
DB_NAME=riciclapp
JWT_SECRET=your_jwt_secret_key

# Configurazione mail (per invio email di verifica e reset password)
EMAIL=esempio_mail_host
PASSWORD_EMAIL=esempio_password_email
