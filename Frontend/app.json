{
  "expo": {
    "name": "RiciclApp",
    "slug": "riciclapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RiciclApp usa la fotocamera per scansionare i codici a barre dei prodotti e fornire informazioni sul riciclo."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "RiciclApp"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      ["expo-router"],
      [
        "expo-camera",
        {
          "cameraPermission": "RiciclApp usa la fotocamera per scansionare i codici a barre dei prodotti e fornire informazioni sul riciclo."
        }
      ]
    ]
  }
}